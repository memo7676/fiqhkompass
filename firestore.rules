rules_version = '2';

// Fiqh-Kompass: accounts, unique player names, rankings.
// Deploy: Firebase console -> Firestore Database -> Rules -> paste this file -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function verified() { return request.auth.token.email_verified == true; }
    // Lower case for player names. lower() in rules only handles A-Z, so the
    // other capitals allowed in names are mapped by hand (same result as JS toLowerCase).
    function fold(n) {
      return n.lower().replace('Ä', 'ä').replace('Ö', 'ö').replace('Ü', 'ü')
        .replace('Ç', 'ç').replace('Ş', 'ş').replace('Ğ', 'ğ')
        // Arabic letters that look alike count as the same name.
        .replace('[\\x{0623}\\x{0625}\\x{0622}]', 'ا')
        .replace('[\\x{0649}\\x{06CC}]', 'ي')
        .replace('\\x{06A9}', 'ك');
    }
    function nameAfter(key) { return getAfter(/databases/$(database)/documents/usernames/$(key)); }

    // Highest possible score of one round (15 questions, all bonuses).
    function maxRound() { return 3250; }

    // One document per player name. The id is the name in lower case, so
    // "Ali" and "ali" cannot both exist.
    match /usernames/{key} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && fold(request.resource.data.name) == key
        // Latin and Arabic letters (no vowel signs), digits, _ . - and single spaces.
        && key.matches('^[a-z0-9äöüßçşğı_.\\x{0621}-\\x{063A}\\x{0641}-\\x{064A}\\x{0660}-\\x{0669}\\x{067E}\\x{0686}\\x{0698}\\x{06A9}\\x{06AF}\\x{06CC}\\x{06F0}-\\x{06F9}-]+( [a-z0-9äöüßçşğı_.\\x{0621}-\\x{063A}\\x{0641}-\\x{064A}\\x{0660}-\\x{0669}\\x{067E}\\x{0686}\\x{0698}\\x{06A9}\\x{06AF}\\x{06CC}\\x{06F0}-\\x{06F9}-]+)*$')
        && key.size() >= 3 && key.size() <= 24;
      // Only the spelling may change (same key), and only by the owner.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && fold(request.resource.data.name) == key;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Private profile: only the player sees it. It is never deleted: deleting
    // the account replaces it with { deletedAt } (no personal data left), so a
    // score card can not be deleted and recreated to replay a week.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['birthYear', 'parentalConsent', 'termsAt', 'createdAt', 'friends'])
        && request.resource.data.birthYear is int
        && request.resource.data.birthYear >= 1920
        && request.resource.data.birthYear <= request.time.year() - 6
        && request.resource.data.parentalConsent is bool
        && request.resource.data.friends is list
        && request.resource.data.friends.size() == 0;
      allow update: if isOwner(uid) && !('deletedAt' in resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'blocked'])
          // Old one-sided friend list: may only shrink (friends now come from friendships).
          && request.resource.data.friends is list
          && request.resource.data.friends.size() <= resource.data.get('friends', []).size()
          && request.resource.data.get('blocked', []) is list
          && request.resource.data.get('blocked', []).size() <= 500)
        || request.resource.data.keys().hasOnly(['deletedAt']));
    }

    // Public score card. Everyone reads it (rankings), only the owner writes it.
    match /players/{uid} {
      function validPlayer() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'nickKey', 'g', 'total', 'games', 'comp', 'at'])
          && d.g in ['m', 'f']
          && d.total is int && d.games is int && d.comp is map
          && d.nick is string && d.nickKey is string
          // Sisters play under a kunya, and only sisters may use one.
          && (d.g == 'f') == d.nickKey.matches('^(umm|bint|mutter von|tochter von|\\x{0627}\\x{0645}|\\x{0628}\\x{0646}\\x{062A}) .+')
          && nameAfter(d.nickKey).data.uid == request.auth.uid
          && nameAfter(d.nickKey).data.name == d.nick;
      }
      allow read: if true;
      // Only together with the registration (the private profile is new).
      allow create: if isOwner(uid) && validPlayer()
        && !exists(/databases/$(database)/documents/users/$(uid))
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.total == 0
        && request.resource.data.games == 0
        && request.resource.data.comp.size() == 0;
      // Points only count with a confirmed e-mail address. Points only grow,
      // by at most one round per write; competition weeks can not be removed
      // (one attempt per week).
      allow update: if isOwner(uid) && verified() && validPlayer()
        && request.resource.data.g == resource.data.g
        && request.resource.data.total >= resource.data.total
        && request.resource.data.total - resource.data.total <= maxRound()
        && request.resource.data.games >= resource.data.games
        && request.resource.data.games - resource.data.games <= 1
        && request.resource.data.comp.keys().hasAll(resource.data.comp.keys())
        && request.resource.data.comp.size() - resource.data.comp.size() <= 1;
      // Only when the whole account is deleted.
      allow delete: if isOwner(uid)
        && 'deletedAt' in getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Chat: only between two brothers or two sisters, readable only by the two.
    function playerG(uid) { return get(/databases/$(database)/documents/players/$(uid)).data.g; }
    function otherOf(m) { return m[0] == request.auth.uid ? m[1] : m[0]; }
    function blockedIn(uid, who) {
      return who in get(/databases/$(database)/documents/users/$(uid)).data.get('blocked', []);
    }
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && verified()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'updatedAt', 'last', 'read'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && playerG(request.resource.data.members[0]) == playerG(request.resource.data.members[1])
        && request.resource.data.last == null
        && request.resource.data.read == {};
      allow update: if signedIn() && verified()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'updatedAt', 'read']);

      match /messages/{msgId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signedIn() && request.auth.uid in chat().members;
        allow create: if signedIn() && verified()
          && request.auth.uid in chat().members
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time
          // Nobody writes to someone who blocked them, or to someone they blocked.
          && !blockedIn(otherOf(chat().members), request.auth.uid)
          && !blockedIn(request.auth.uid, otherOf(chat().members));
      }
    }

    // Friend requests: <from>_<to>. Only between two brothers or two sisters
    // (like the chat), never to or from someone who blocked the other.
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friendsDoc(a, b) { return /databases/$(database)/documents/friendships/$(pairId(a, b)); }
    match /friendRequests/{id} {
      allow read, delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && verified()
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/players/$(request.resource.data.to))
        && playerG(request.auth.uid) == playerG(request.resource.data.to)
        && !exists(friendsDoc(request.auth.uid, request.resource.data.to))
        && !blockedIn(request.resource.data.to, request.auth.uid)
        && !blockedIn(request.auth.uid, request.resource.data.to);
    }

    // Friendship: exists only after the other one sent a request and this one accepted it.
    // Either of the two can end it.
    match /friendships/{id} {
      allow read, delete: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && verified()
        && request.resource.data.keys().hasOnly(['users', 'at'])
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/friendRequests/$(otherOf(request.resource.data.users) + '_' + request.auth.uid));
    }

    // Reports about chat messages: write-only, read in the Firebase console.
    match /reports/{id} {
      allow create: if signedIn() && verified()
        && request.resource.data.keys().hasOnly(['from', 'about', 'chatId', 'text', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.about is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.at == request.time;
    }

    // Learning progress: private, only the player reads and writes it.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && verified()
        && request.resource.data.keys().hasOnly(['q', 'at'])
        && request.resource.data.q is map
        && request.resource.data.q.size() <= 5000
        && request.resource.data.at is int;
    }

    // Public profile picture.
    match /avatars/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && verified()
        && request.resource.data.keys().hasOnly(['img'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 60000
        && request.resource.data.img.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$');
      allow delete: if isOwner(uid);
    }
  }
}
